# Optional, local dev only. Copy to .env.local (git-ignored). Read only by the dev server, never sent to the browser.
# Players can instead enter their own OpenAI key on the setup screen (the only option on GitHub Pages).

# Which backend prices the AI's bids: openai (default). Add more in server/providers/.
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini
# AI_TIMEOUT_MS=25000
